{
  "name": "vite_web_app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:expert": "vite --config vite.expert.config.ts",
    "build": "tsc -b && vite build",
    "build:expert": "tsc -b && vite build --config vite.expert.config.ts",
